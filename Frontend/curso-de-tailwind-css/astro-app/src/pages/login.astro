---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title="Iniciar sesión"
			description="Inicia sesión para acceder a tu cuenta."
		/>
	</head>

	<body class="bg-slate-50">
		<Header />

		<main class="mx-auto grid min-h-[calc(100vh-4rem)] w-full max-w-none place-items-center px-4 py-10 sm:px-6 lg:px-8">
			<section class="w-full max-w-lg rounded-xl bg-white p-6 shadow-lg sm:p-8">
				<div class="mb-8">
					<h1 class="mb-2 text-3xl font-bold text-slate-800">
						Welcome back
					</h1>
					<p class="text-slate-500">
						Enter your credentials to access your account.
					</p>
				</div>

				<form action="#" method="POST" class="space-y-6">
					<div>
						<label for="email" class="mb-2 block text-sm font-medium text-slate-700">
							Email
						</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							placeholder="john@example.com"
							required
							class="form-input w-full rounded-md border-slate-300 px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:border-teal-500 focus:ring-teal-500"
						/>
					</div>

					<div>
						<div class="mb-2 flex items-center justify-between gap-4">
							<label for="password" class="block text-sm font-medium text-slate-700">
								Password
							</label>
							<a
								href="#"
								class="text-sm font-medium text-teal-600 no-underline transition hover:text-teal-700"
							>
								Forgot password?
							</a>
						</div>
						<input
							id="password"
							name="password"
							type="password"
							autocomplete="current-password"
							placeholder="Enter your password"
							required
							class="form-input w-full rounded-md border-slate-300 px-4 py-3 text-slate-800 placeholder:text-slate-400 focus:border-teal-500 focus:ring-teal-500"
						/>
					</div>

					<div class="flex items-center gap-3">
						<input
							id="remember"
							name="remember"
							type="checkbox"
							class="form-checkbox size-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500"
						/>
						<label for="remember" class="text-sm text-slate-600">
							Remember me
						</label>
					</div>

					<button
						type="submit"
						class="w-full rounded-md bg-teal-500 px-4 py-3 font-semibold text-white transition hover:bg-teal-700 focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 focus:outline-none"
					>
						Sign In
					</button>
				</form>

				<div class="my-7 flex items-center gap-4">
					<div class="h-px flex-1 bg-slate-200"></div>
					<span class="text-xs font-medium text-slate-400 uppercase">New here?</span>
					<div class="h-px flex-1 bg-slate-200"></div>
				</div>

				<a
					href="/register"
					class="flex w-full items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-3 font-semibold text-slate-700 no-underline transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-700 focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 focus:outline-none"
				>
					Create an account
				</a>
			</section>
		</main>

		<Footer />
	</body>
</html>
